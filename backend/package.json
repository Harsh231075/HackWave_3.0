{
  "name": "orlo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "RUN_MONGO_TESTS=1 node --experimental-strip-types --test test/mongo.integration.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
