{
  "name": "orlo-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local index.ts",
    "dev": "node --watch --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local index.ts",
    "test": "node --experimental-strip-types --test *.test.ts",
    "test:auth": "node --experimental-strip-types --test backend/auth.test.ts",
    "test:chat": "node --experimental-strip-types --test chat.test.ts",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@openuidev/lang-core": "^0.3.2",
    "better-auth": "^1.7.7",
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
