PORT=3001
HOST=127.0.0.1

# Better Auth (server only). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
AUTH_DB_PATH=.auth-data/auth.sqlite

# Application records: MongoDB Atlas or another MongoDB replica set
MONGODB_URI=

# Optional Google sign-in (callback /api/auth/callback/google)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# OpenAI-compatible API: base includes /v1, without /chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_API_FORMAT=chat
OPENAI_API_KEY=
OPENAI_MODEL=
