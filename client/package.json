{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run generate:openui && vite",
    "build": "npm run generate:openui && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:openui": "node scripts/generate-openui.mjs",
    "start": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "test:chat": "node --experimental-strip-types --test server/chat.test.ts",
    "test": "node --experimental-strip-types --test server/*.test.ts",
    "test:render": "node scripts/integration-render.mjs",
    "test:continuity": "node scripts/verify-continuity.mjs",
    "test:local-data": "node scripts/verify-local-data.mjs",
    "test:plugin-import": "node scripts/verify-plugin-import.mjs",
    "test:extensions": "node scripts/verify-extensions.mjs",
    "test:kanban": "node scripts/verify-kanban.mjs",
    "test:intent:live": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-intent-live.mjs",
    "test:organizing": "node scripts/verify-organizing.mjs",
    "test:mail": "node scripts/verify-mail.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@openuidev/lang-core": "^0.3.2",
    "@openuidev/react-lang": "^0.3.2",
    "@openuidev/react-ui": "^0.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
