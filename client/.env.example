# Copy to .env.local. Server credentials must never use a VITE_ prefix.

# ── Groq (default, recommended for hackathon — fast & free tier) ──
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── OpenAI (alternative) ──
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Ollama (local, offline) ──
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Compact intent/composition JSON budget (256–8192). Increase for larger layouts.
MODEL_STRUCTURED_MAX_TOKENS=768

# Google Calendar (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/google/callback
APP_ORIGIN=http://localhost:5173
# Production: 64 hex characters; locally a private key is generated automatically.
CALENDAR_TOKEN_KEY=
# Set to persistent storage when deploying.
# CALENDAR_DATA_DIR=server/.calendar-data
