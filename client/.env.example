# Copy to .env.local. Server credentials must never use a VITE_ prefix.

# ── Groq (default, recommended for hackathon — fast & free tier) ──
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── OpenAI (alternative) ──
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Ollama (local, offline) ──
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
