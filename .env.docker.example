# Copy to .env.docker, which is gitignored. Generate using: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
AUTH_DB_PATH=/data/auth.sqlite
ORLO_PORT=5173

# Compose supplies MONGODB_URI automatically for its private MongoDB replica set.

# Optional AI provider settings (server only)
OPENAI_API_KEY=
# Base includes /v1, without /chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1
# chat for OpenAI-compatible APIs; responses when the provider supports it
MODEL_API_FORMAT=chat
OPENAI_MODEL=

# Optional Google sign-in; callback: http://localhost:5173/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Optional Calendar integration; use a separate random 64-character hex encryption key.
# Generate using: openssl rand -hex 32
CALENDAR_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/google/callback

# Optional Mail extension public OAuth client ID. Passed only to the frontend build.
VITE_GOOGLE_CLIENT_ID=
